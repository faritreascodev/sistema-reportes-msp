# Base de datos SQLite local (ruta relativa a la raíz del proyecto)
DATABASE_URL="file:./storage/reportes.db"

# Carpeta donde se guardan imágenes, PDF firmados, etc.
STORAGE_DIR="./storage"

# Zona horaria para la estampa de firma y formateo de fechas
TZ="America/Guayaquil"

# Datos que se escriben en el diccionario de firma del PDF
SIGN_LOCATION="Esmeraldas, Ecuador"
SIGN_REASON="Reporte de verificable de actividades de promoción"
SIGN_CONTACT="Centro de Salud Tipo B N1"
# adbe.pkcs7.detached (igual que FirmaEC) o ETSI.CAdES.detached (PAdES-B)
SIGN_SUBFILTER="adbe.pkcs7.detached"

# Opcional: ruta a un Chrome/Chromium ya instalado (Docker usa el del sistema)
# PUPPETEER_EXECUTABLE_PATH=""
